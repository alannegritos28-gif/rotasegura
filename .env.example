# RotaSegura Professional 2.0
NEXT_PUBLIC_APP_NAME=Rota Segura
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Supabase - use a integração Netlify/Supabase ou configure manualmente
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Identificação obrigatória para geocodificação pública
NOMINATIM_USER_AGENT=RotaSegura/2.0 (contato@rotasegura.com.br)

# Provedores / conectores
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
DAER_WFS_URL=https://mapa.daer.rs.gov.br/i3geo/ogc.php
DNIT_DATA_URL=https://www.gov.br/dnit/pt-br/acesso-a-informacao/dados-abertos/conjuntos-de-dados
INMET_ALERT_URL=https://alertas2.inmet.gov.br/
CEMADEN_URL=https://www.gov.br/cemaden/pt-br

# Segurança / operação
ALLOWED_ORIGIN=http://localhost:3000
INCIDENT_MAX_PER_10_MIN=8
ROUTE_MAX_PER_MIN=20

# RotaSegura Data Hub - conectores oficiais (configure somente URLs aprovadas pelos órgãos)
DATAHUB_TIMEOUT_MS=12000
DAER_WFS_URL=https://mapa.daer.rs.gov.br/i3geo/ogc.php
# Para ingestão de eventos em GeoJSON/JSON, configure endpoint/consulta que retorne feições relevantes:
DAER_WFS_GEOJSON_URL=
CEMADEN_EVENTS_URL=
CEMADEN_TOKEN=
INMET_ALERTS_URL=
DNIT_EVENTS_URL=
DEFESA_CIVIL_EVENTS_URL=
CEMADEN_HEALTH_URL=https://sws.cemaden.gov.br/PED/api/ui/swagger.json
INMET_HEALTH_URL=https://wis2bra.inmet.gov.br/oapi?f=json
